<Window x:Class="GaameTranslate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GaameTranslate" Style="{StaticResource {x:Type Window}}" Width="1180" Height="820" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Page" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Setter Property="Margin" Value="34,28,34,20" /></Style>
    <DataTemplate x:Key="WordTemplate"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Word}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{Binding Context}" Style="{StaticResource Muted}" Margin="0,6,18,0" MaxHeight="44" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Translation}" FontSize="16" /><TextBlock Text="{Binding Tags}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" /></StackPanel></Grid></DataTemplate>
    <DataTemplate x:Key="HistoryTemplate"><StackPanel><DockPanel><TextBlock Text="{Binding Provider}" Style="{StaticResource Muted}" DockPanel.Dock="Right" FontSize="12" /><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM · HH:mm}}" Style="{StaticResource Muted}" FontSize="12" /></DockPanel><TextBlock Text="{Binding OriginalText}" MaxHeight="24" TextTrimming="CharacterEllipsis" Margin="0,8,0,6" /><TextBlock Text="{Binding TranslatedText}" Foreground="{DynamicResource AccentBrush}" MaxHeight="48" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="206" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,28,16,20">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0"><Path Data="M 7 7 L 21 7 M 14 7 L 14 23 M 7 16 L 21 16 M 21 16 L 24 23 M 21 16 L 18 23" Stroke="#112B22" StrokeThickness="2" Width="26" Height="28" /></Border><TextBlock Text="Gaame" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel><TextBlock Text="TRANSLATE · WINDOWS" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="1,12,0,0" /></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="YOUR SCREEN. YOUR WORDS." FontSize="9" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="OCR stays on this PC." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" /></StackPanel></Border><TextBlock Text="v0.1.0  ·  Made for the moment" FontSize="10" Style="{StaticResource Muted}" HorizontalAlignment="Center" /></StackPanel>
        <ListBox SelectedIndex="{Binding PageIndex}" ItemContainerStyle="{StaticResource NavItem}" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Continue">
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M1 8 L9 1 L17 8 L17 18 L11 18 L11 12 L7 12 L7 18 L1 18 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4" Width="20" Margin="0,0,14,0" /><TextBlock Text="Home" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M1 6 L1 1 L6 1 M12 1 L17 1 L17 6 M17 12 L17 17 L12 17 M6 17 L1 17 L1 12 M6 9 L12 9 M9 6 L9 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.5" Width="20" Margin="0,0,14,0" /><TextBlock Text="Translate" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M2 2 L8 2 L10 4 L12 2 L18 2 L18 17 L12 17 L10 19 L8 17 L2 17 Z M10 4 L10 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4" Width="20" Margin="0,0,14,0" /><TextBlock Text="Vocabulary" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M2 5 L15 5 L15 18 L2 18 Z M5 2 L18 2 L18 15 M6 11 L9 14 L13 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4" Width="20" Margin="0,0,14,0" /><TextBlock Text="Review" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M2 8 A8 8 0 1 1 3 15 M2 3 L2 8 L7 8 M10 6 L10 11 L14 13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.5" Width="20" Margin="0,0,14,0" /><TextBlock Text="History" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><Path Data="M3 4 L17 4 M3 10 L17 10 M3 16 L17 16 M7 1 L7 7 M13 7 L13 13 M8 13 L8 19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.5" Width="20" Margin="0,0,14,0" /><TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <Grid><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="A little less guessing." FontSize="32" FontWeight="SemiBold" /><TextBlock Text="A whole new world of understanding." Style="{StaticResource Muted}" Margin="0,8,0,26" FontSize="16" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18" Visibility="{Binding NeedsProviderSetup, Converter={StaticResource BoolVisibility}}"><DockPanel><Button Content="Set up translation" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="16,0,0,0" /><StackPanel><TextBlock Text="One quick step before your first translation" FontWeight="SemiBold" /><TextBlock Text="Add a DeepL / Azure key, or connect a local LibreTranslate service." Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="PLAY. CAPTURE. UNDERSTAND." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Your next line of dialogue, translated." FontSize="23" FontWeight="SemiBold" Margin="0,13,0,9" /><TextBlock Text="Select text anywhere on your screen. Read the translation, explore a word, and keep it for later." Style="{StaticResource Muted}" MaxWidth="430" HorizontalAlignment="Left" /><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="Translate a region" Command="{Binding RegionCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="Full screen" Command="{Binding FullscreenCommand}" Margin="10,0,0,0" /></StackPanel></StackPanel><Border Grid.Column="1" Width="116" Height="116" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Background="{DynamicResource BackgroundBrush}"><Grid><Path Data="M12 0 L0 0 L0 12 M48 0 L60 0 L60 12 M60 48 L60 60 L48 60 M12 60 L0 60 L0 48" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="60" Height="60" /><TextBlock Text="Aa" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border></Grid></Border>
            <Grid Margin="0,18,0,26"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="TRANSLATION" Style="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding Settings.Provider}" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding Settings.TargetLanguage, StringFormat=Target language: {0}}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="YOUR VOCABULARY" Style="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding WordCount, StringFormat={}{0} saved words}" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding DueCount, StringFormat={}{0} ready to review}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="QUICK CAPTURE" Style="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding Settings.Hotkeys.Region}" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Works while the app is in the tray" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border></Grid>
            <DockPanel Margin="0,0,0,12"><Button Content="Open vocabulary" Command="{Binding OpenVocabularyCommand}" DockPanel.Dock="Right" Padding="12,6" /><TextBlock Text="Words worth keeping" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            <ItemsControl ItemsSource="{Binding RecentWords}" ItemTemplate="{StaticResource WordTemplate}" Margin="4,4,4,14"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,6,0,12" /></Style></ItemsControl.ItemContainerStyle></ItemsControl>
            <TextBlock Text="No words saved yet. Click a recognized word in the translation overlay to start your collection." ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding WordCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="Recent translations" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,12" /><ItemsControl ItemsSource="{Binding RecentHistory}" ItemTemplate="{StaticResource HistoryTemplate}"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,18" /></Style></ItemsControl.ItemContainerStyle></ItemsControl>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Translate" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="From a game, a browser, or a thought." Style="{StaticResource Muted}" Margin="0,8,0,24" />
            <WrapPanel Margin="0,0,0,18"><Button Content="Select region" Command="{Binding RegionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" /><Button Content="Full screen" Command="{Binding FullscreenCommand}" Margin="0,0,10,8" /><Button Content="Repeat region" Command="{Binding RepeatCommand}" Margin="0,0,10,8" /><Button Content="All monitors" Command="{Binding AllScreensCommand}" Margin="0,0,0,8" /></WrapPanel>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedValuePath="Code" SelectedValue="{Binding SourceLanguage}" AutomationProperties.Name="Source language" /><Button Grid.Column="1" Content="Swap" Command="{Binding SwapLanguagesCommand}" Margin="10,0" /><ComboBox Grid.Column="2" ItemsSource="{Binding TargetLanguages}" SelectedValuePath="Code" SelectedValue="{Binding TargetLanguage}" AutomationProperties.Name="Target language" /></Grid><TextBlock Text="{Binding LanguagePairLabel}" Style="{StaticResource Muted}" Margin="0,0,0,14" /><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Text translation" Style="{StaticResource SectionTitle}" /><TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Source text" /><CheckBox Content="Translate sentences separately" IsChecked="{Binding SplitSentences}" Margin="0,12,0,14" /><DockPanel><Button Content="Translate text" Command="{Binding TranslateTextCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" /><TextBlock Text="Language pair and provider follow Settings." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0" /></DockPanel></StackPanel></Border>
            <DockPanel Margin="0,24,0,12"><Button Content="Copy translation" Command="{Binding CopyOutputCommand}" DockPanel.Dock="Right" Padding="12,6" /><TextBlock Text="Translation" Style="{StaticResource SectionTitle}" Margin="0" /></DockPanel><TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" VerticalContentAlignment="Top" FontSize="18" AutomationProperties.Name="Translation result" />
            <TextBlock Text="{Binding PipelineInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" /><WrapPanel Margin="0,18,0,0"><Button Content="Show / hide overlay" Command="{Binding ToggleOverlayCommand}" Margin="0,0,10,0" /><Button Content="Toggle click-through" Command="{Binding ToggleInteractionCommand}" /></WrapPanel>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel><Button Content="Add word" Click="AddWord_Click" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" /><StackPanel><TextBlock Text="Your vocabulary" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Keep the words you meet along the way." Style="{StaticResource Muted}" Margin="0,8,0,20" /></StackPanel></DockPanel>
          <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBox Text="{Binding WordSearch, UpdateSourceTrigger=PropertyChanged}" TextChanged="WordSearch_Changed" AutomationProperties.Name="Search vocabulary" ToolTip="Search words, meanings, context, notes or tags" /><ComboBox x:Name="VocabularyLanguage" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="VocabularyFilter_Changed" AutomationProperties.Name="Language filter" /><ComboBox x:Name="VocabularySort" Grid.Column="2" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="VocabularyFilter_Changed"><ComboBoxItem Content="Newest first" /><ComboBoxItem Content="Word A–Z" /><ComboBoxItem Content="Due first" /><ComboBoxItem Content="This week" /></ComboBox></Grid>
          <Grid Grid.Row="2"><ListBox x:Name="WordsList" ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord}" ItemTemplate="{StaticResource WordTemplate}" MouseDoubleClick="EditWord_Click" /><TextBlock Text="Your collection starts with one word.&#x0a;Translate a region, click a word, and save it here." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Words.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="Edit selected" Click="EditWord_Click" Margin="0,0,8,6" /><Button Content="Delete selected" Command="{Binding DeleteWordCommand}" Margin="0,0,8,6" /><Button Content="Import CSV" Click="Import_Click" Margin="0,0,8,6" /><Button Content="Export CSV" Click="Export_Click" Margin="0,0,8,6" /><Button Content="Export for Anki" Click="Anki_Click" Margin="0,0,0,6" /></WrapPanel>
        </Grid>
        <Grid><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Make it stick." FontSize="30" FontWeight="SemiBold" /><TextBlock Text="A few words today. A little more fluency tomorrow." Style="{StaticResource Muted}" Margin="0,8,0,26" />
            <Border Style="{StaticResource Card}" MinHeight="300"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540"><TextBlock Text="{Binding DueCount, StringFormat={}{0} words ready to review}" Style="{StaticResource Muted}" HorizontalAlignment="Center" /><TextBlock Text="{Binding ReviewCard.Word, TargetNullValue=Ready for a quick review?}" FontSize="36" FontWeight="SemiBold" TextAlignment="Center" Margin="0,30,0,18" /><TextBlock Text="{Binding ReviewCard.Context}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,20" /><StackPanel Visibility="{Binding AnswerRevealed, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ReviewCard.Translation}" FontSize="24" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" /><TextBlock Text="{Binding ReviewCard.Notes}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,0" /></StackPanel></StackPanel></Border>
            <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0"><Button Content="Next due card" Command="{Binding StartReviewCommand}" Margin="0,0,10,10" /><Button Content="Reveal answer" Command="{Binding RevealAnswerCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" /></WrapPanel>
            <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding AnswerRevealed, Converter={StaticResource BoolVisibility}}"><Button Content="Again · 10 min" Command="{Binding GradeCommand}" CommandParameter="Again" Margin="0,0,8,8" /><Button Content="Hard" Command="{Binding GradeCommand}" CommandParameter="Hard" Margin="0,0,8,8" /><Button Content="Good" Command="{Binding GradeCommand}" CommandParameter="Good" Margin="0,0,8,8" /><Button Content="Easy" Command="{Binding GradeCommand}" CommandParameter="Easy" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock Text="Your review schedule is saved locally and follows each word across sessions." Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,26,0,0" />
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="4"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Translation history" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Pick up where you left off. Screenshots are never stored." Style="{StaticResource Muted}" Margin="0,8,0,24" /></StackPanel><TextBox Grid.Row="1" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" TextChanged="HistorySearch_Changed" Margin="0,0,0,16" AutomationProperties.Name="Search history" /><Grid Grid.Row="2"><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" ItemTemplate="{StaticResource HistoryTemplate}" MouseDoubleClick="Reopen_Click" /><TextBlock Text="No translations here yet." HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Reopen translation" Click="Reopen_Click" Margin="0,0,8,6" /><Button Content="Copy selected" Click="CopyHistory_Click" Margin="0,0,8,6" /><Button Content="Delete selected" Command="{Binding DeleteHistoryCommand}" Margin="0,0,8,6" /><Button Content="Clear history" Click="ClearHistory_Click" Margin="0,0,0,6" /></WrapPanel>
        </Grid>
        <Grid x:Name="SettingsHost"><Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="5"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style></Grid>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12" Background="{DynamicResource SidebarBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" /><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" MaxHeight="52" AutomationProperties.LiveSetting="Polite" /></StackPanel><Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="16,0,0,0" Padding="12,5" /></Grid></Border>
    </Grid>
  </Grid>
</Window>
