<Window x:Class="GaameTranslate.App.WordEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GaameTranslate.App" Title="{loc:Loc Key='Добавить слово'}" Width="720" Height="720" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsTheme.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
  </ResourceDictionary></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="28,24,28,20"><TextBlock x:Name="Heading" Text="{loc:Loc Key='Добавить слово'}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Key='Сохраните перевод, чтобы вернуться к нему позже.'}" Style="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
    <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Form" Margin="28,0,28,20">
      <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
        <TextBlock Text="{loc:Loc Key='Слово или выражение *'}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="Word" FontSize="22" TextChanged="Word_Changed" AutomationProperties.Name="{loc:Loc Key='Слово или выражение'}" AutomationProperties.AutomationId="word-editor-word" />
        <TextBlock Text="{loc:Loc Key='Перевод *'}" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" /><TextBox x:Name="Meaning" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58" MaxHeight="130" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Key='Перевод'}" AutomationProperties.AutomationId="word-editor-translation" />
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Key='Язык слова'}" Style="{StaticResource FieldLabel}" /><Grid><ComboBox x:Name="Source" SelectedValuePath="Code" AutomationProperties.Name="{loc:Loc Key='Язык слова'}" AutomationProperties.AutomationId="word-editor-source" /><TextBlock Text="{loc:Loc Key='Выберите язык…'}" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Margin="13,0,32,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Source}" Value="-1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Key='Язык перевода'}" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="Target" SelectedValuePath="Code" AutomationProperties.Name="{loc:Loc Key='Язык перевода'}" AutomationProperties.AutomationId="word-editor-target" /></StackPanel></Grid>
      </StackPanel></Border>
      <Expander x:Name="ContextSection" Header="{loc:Loc Key='Контекст из игры'}" Style="{StaticResource SettingsExpander}" Margin="0,14,0,0" AutomationProperties.AutomationId="word-editor-context-section"><StackPanel Margin="0,8,0,8"><TextBlock Text="{loc:Loc Key='С контекстом легче вспомнить, где встретилось слово.'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" /><TextBlock Text="{loc:Loc Key='Исходная реплика'}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="OriginalContext" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="180" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Key='Исходная реплика'}" AutomationProperties.AutomationId="word-editor-context" /><TextBlock Text="{loc:Loc Key='Перевод реплики'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="TranslatedContext" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="180" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Key='Перевод реплики'}" AutomationProperties.AutomationId="word-editor-translated-context" /></StackPanel></Expander>
      <Expander Header="{loc:Loc Key='Заметки и теги'}" Style="{StaticResource SettingsExpander}" Margin="0,6,0,0" AutomationProperties.AutomationId="word-editor-notes-section"><StackPanel Margin="0,8,0,8"><TextBlock Text="{loc:Loc Key='Мои заметки'}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="180" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Key='Мои заметки'}" AutomationProperties.AutomationId="word-editor-notes" /><TextBlock Text="{loc:Loc Key='Теги'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="Tags" AutomationProperties.Name="{loc:Loc Key='Теги'}" AutomationProperties.AutomationId="word-editor-tags" /><TextBlock Text="{loc:Loc Key='Например: Disco Elysium, диалоги, путешествия'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Expander>
      <Expander Header="{loc:Loc Key='Словарные подробности'}" Style="{StaticResource SettingsExpander}" Margin="0,6,0,0" AutomationProperties.AutomationId="word-editor-details-section"><StackPanel x:Name="ExtraFields" Margin="0,8,0,8" /></Expander>
      <TextBlock Text="{loc:Loc Key='* Обязательные поля. Остальное можно добавить позже.'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" />
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,16,28,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource SettingsErrorBrush}" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="word-editor-feedback" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SaveHint" Text="{loc:Loc Key='Карточка сохранится в вашем словаре.'}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="Cancel" Content="{loc:Loc Key='Отмена'}" Click="Cancel_Click" Margin="0,0,10,0" AutomationProperties.AutomationId="word-editor-cancel" /><Button x:Name="Save" Content="{loc:Loc Key='Добавить слово'}" Click="Save_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="word-editor-save" /></StackPanel></Grid></Grid></Border>
  </Grid>
</Window>
