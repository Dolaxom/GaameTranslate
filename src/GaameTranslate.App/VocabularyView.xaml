<UserControl x:Class="GaameTranslate.App.VocabularyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GaameTranslate.App" xmlns:local="clr-namespace:GaameTranslate.App">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsTheme.xaml" /></ResourceDictionary.MergedDictionaries>
      <local:VocabularyLabelConverter x:Key="WordLabel" />
      <Style TargetType="ContextMenu"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5"><StackPanel IsItemsHost="True" /></Border></ControlTemplate></Setter.Value></Setter></Style>
      <Style TargetType="MenuItem"><Setter Property="Padding" Value="13,10" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{DynamicResource BorderBrush}" Height="1" Margin="10,4" /></ControlTemplate></Setter.Value></Setter></Style>
      <DataTemplate x:Key="VocabularyRow">
        <StackPanel>
          <DockPanel><TextBlock Text="{loc:Loc Key={Binding Converter={StaticResource WordLabel}, ConverterParameter=language}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" Margin="10,4,0,0" /><TextBlock Text="{Binding Word}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DockPanel>
          <TextBlock Text="{Binding Translation}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="44" />
          <TextBlock Text="{loc:Loc Key={Binding Converter={StaticResource WordLabel}, ConverterParameter=preview}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="34,28,34,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{loc:Loc Key='Мой словарь'}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc Key='Слова из игр, которые хочется запомнить.'}" Style="{StaticResource Muted}" Margin="0,7,0,10" /><WrapPanel><TextBlock Text="{loc:Loc Key='Сохранено: {0}', Value={Binding WordCount}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,20,0" /><TextBlock Text="{loc:Loc Key='К повторению: {0}', Value={Binding DueCount}}" Style="{StaticResource Muted}" /></WrapPanel></StackPanel>
      <Button Grid.Column="1" Content="{loc:Loc Key='＋ Добавить слово'}" Click="Add_Click" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="vocabulary-add" />
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Loc Key='Найти слово'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" /><Grid><TextBox x:Name="Search" Text="{Binding WordSearch, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_Changed" Padding="12,9,34,9" AutomationProperties.Name="{loc:Loc Key='Поиск по словарю'}" AutomationProperties.AutomationId="vocabulary-search" ToolTip="{loc:Loc Key='Слово, перевод, контекст, заметка или тег'}" /><TextBlock Text="{loc:Loc Key='Слово, перевод или тег…'}" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Margin="13,0,30,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="×" Click="ClearSearch_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="10,5" ToolTip="{loc:Loc Key='Очистить поиск'}" AutomationProperties.Name="{loc:Loc Key='Очистить поиск'}" /></Grid></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{loc:Loc Key='Язык слова'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" /><ComboBox x:Name="LanguageFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="{loc:Loc Key='Язык слова'}" AutomationProperties.AutomationId="vocabulary-language" /></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Key='Порядок'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" /><ComboBox x:Name="Sort" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="{loc:Loc Key='Порядок карточек'}" AutomationProperties.AutomationId="vocabulary-sort"><ComboBoxItem Content="{loc:Loc Key='Сначала новые'}" /><ComboBoxItem Content="{loc:Loc Key='По алфавиту'}" /><ComboBoxItem Content="{loc:Loc Key='Пора повторить'}" /><ComboBoxItem Content="{loc:Loc Key='За эту неделю'}" /></ComboBox></StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid x:Name="CollectionLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock x:Name="ResultCount" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,10" AutomationProperties.AutomationId="vocabulary-count" /><ListBox x:Name="WordsList" Grid.Row="1" ItemTemplate="{StaticResource VocabularyRow}" SelectionChanged="Selection_Changed" MouseDoubleClick="List_DoubleClick" AutomationProperties.Name="{loc:Loc Key='Сохранённые слова'}" AutomationProperties.AutomationId="vocabulary-list" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <StackPanel x:Name="NoResults" Grid.Row="1" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock Text="{loc:Loc Key='Ничего не найдено'}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{loc:Loc Key='Попробуйте другое слово или сбросьте фильтры.'}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,16" /><Button Content="{loc:Loc Key='Сбросить фильтры'}" Click="Reset_Click" HorizontalAlignment="Center" AutomationProperties.AutomationId="vocabulary-reset" /></StackPanel>
        </Grid>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Margin="22" /></ScrollViewer>
          <StackPanel Grid.Row="1" Margin="18,12,18,18"><WrapPanel x:Name="SelectionActions"><Button x:Name="Edit" Content="{loc:Loc Key='Редактировать'}" Click="Edit_Click" Padding="14,9" Margin="0,0,8,6" AutomationProperties.AutomationId="vocabulary-edit" /><Button x:Name="Delete" Content="{loc:Loc Key='Удалить'}" Click="Delete_Click" Background="Transparent" Padding="12,9" Margin="0,0,0,6" AutomationProperties.AutomationId="vocabulary-delete" /></WrapPanel><StackPanel x:Name="DeleteConfirmation" Visibility="Collapsed"><TextBlock Text="{loc:Loc Key='Удалить эту карточку из словаря?'}" Margin="0,0,0,10" /><WrapPanel><Button Content="{loc:Loc Key='Отмена'}" Click="CancelDelete_Click" Padding="12,8" Margin="0,0,8,0" /><Button Content="{loc:Loc Key='Удалить карточку'}" Click="ConfirmDelete_Click" Padding="12,8" AutomationProperties.AutomationId="vocabulary-confirm-delete" /></WrapPanel></StackPanel></StackPanel>
        </Grid></Border>
      </Grid>
      <Border x:Name="EmptyCollection" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Margin="20"><TextBlock Text="{loc:Loc Key='Aa'}" FontSize="44" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" Margin="0,0,0,16" /><TextBlock Text="{loc:Loc Key='Начните с одного слова'}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{loc:Loc Key='Сохраните слово из экранного перевода или добавьте его вручную. Здесь будут перевод, контекст и заметки для повторения.'}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,22" /><Button Content="{loc:Loc Key='Добавить первое слово'}" Click="Add_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="vocabulary-empty-add" /></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><WrapPanel><Button Content="{loc:Loc Key='Файлы и Anki ▾'}" Click="Tools_Click" Padding="12,8" AutomationProperties.AutomationId="vocabulary-tools"><Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc Key='Импорт из CSV…'}" Click="Import_Click" /><Separator /><MenuItem Header="{loc:Loc Key='Экспорт видимых карточек в CSV…'}" Click="Export_Click" /><MenuItem Header="{loc:Loc Key='Экспорт видимых карточек для Anki…'}" Click="Anki_Click" /><Separator /><MenuItem Header="{loc:Loc Key='Синхронизировать весь словарь с Anki'}" Click="SyncAnki_Click" /></ContextMenu></Button.ContextMenu></Button></WrapPanel><Button Grid.Column="1" Content="{loc:Loc Key='Повторить слова →'}" Click="Review_Click" Padding="12,8" AutomationProperties.AutomationId="vocabulary-review" /></Grid>
  </Grid>
</UserControl>
